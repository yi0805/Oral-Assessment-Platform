# ============================================================
# Project 20 — AI Oral Assessment Tool
# Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://project20:localdev123@localhost:5432/project20_dev

# ------------------------------------------------------------
# AI API Keys (REQUIRED for full AI functionality)
# ------------------------------------------------------------

# Google AI Studio key — used for embedding via gemini-embedding-001 (768-dim vectors)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REMOVED_SECRET
# OpenRouter key — used for all chat/LLM completions via openrouter/free model
# See: https://openrouter.ai/openrouter/free
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=REMOVED_SECRET
# ------------------------------------------------------------
# Storage backend (local or s3)
# ------------------------------------------------------------
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-2
AWS_PROFILE_NAME=
S3_BUCKET_NAME=team8-project20-materials
S3_ENDPOINT_URL=

# ------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=REMOVED_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_INSTRUCTOR_DOMAINS=auckland.ac.nz
GOOGLE_INSTRUCTOR_ALLOWLIST=
GOOGLE_ALLOWED_LOGIN_DOMAINS=

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_SECRET_KEY=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
HOST=0.0.0.0
PORT=8000
DEBUG=true
