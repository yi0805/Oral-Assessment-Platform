# Project 20 environment variables

DATABASE_URL=postgresql://project20:localdev123@localhost:5432/project20_dev

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=project20-materials

OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=REMOVED_SECRET
# Must match exactly one of the Authorized Redirect URIs in your Google Cloud Console project.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Role assignment for brand-new accounts ---
# Comma-separated list of email domains whose users become instructors automatically.
# Example: INSTRUCTOR_EMAIL_DOMAINS=staff.university.edu,faculty.university.edu
INSTRUCTOR_EMAIL_DOMAINS=

# Comma-separated list of specific email addresses that become instructors.
# Example: INSTRUCTOR_EMAIL_WHITELIST=alice@gmail.com,bob@example.com
INSTRUCTOR_EMAIL_WHITELIST=

JWT_SECRET_KEY=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Where the React/Vue SPA lives. After a successful Google login the backend
# redirects to {FRONTEND_URL}/auth/callback?token=<jwt>&role=<role>
# Leave blank to receive plain JSON instead (handy for testing with curl/Swagger).
FRONTEND_URL=http://localhost:5173

HOST=0.0.0.0
PORT=8000
DEBUG=true
