DATABASE_URL=<postgres-connection-string>

STORAGE_BACKEND=s3
S3_BUCKET_NAME=team8-project20-materials
AWS_REGION=ap-southeast-2

# AWS credentials — use ONE of the following:
# Option 1 (team members with UoA SSO): set the profile, then run `aws sso login --profile uoa-sso`
AWS_PROFILE_NAME=uoa-sso
# Option 2 (external reviewers): comment out AWS_PROFILE_NAME above and uncomment the two lines below
# AWS_ACCESS_KEY_ID=<aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

GEMINI_API_KEY=REMOVED_SECRET
OPENROUTER_API_KEY=REMOVED_SECRET
AWS_BEARER_TOKEN_BEDROCK=<bedrock-bearer-token>

GOOGLE_INSTRUCTOR_DOMAINS=[aucklanduni.ac.nz]
GOOGLE_INSTRUCTOR_ALLOWLIST= tangyh2023@gmail.com
GOOGLE_ALLOWED_LOGIN_DOMAINS=[aucklanduni.ac.nz,auckland.ac.nz, gmail.com]

JWT_SECRET_KEY=<random-secret-string>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180

RATE_LIMIT_DEFAULT=300

