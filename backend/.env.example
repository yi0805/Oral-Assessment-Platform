# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://project20:localdev123@localhost:5432/project20_dev
# rds database
# DATABASE_URL=postgresql://project20:399project20-team8@project20-db-pg16.cntu207sfdan.ap-southeast-2.rds.amazonaws.com:5432/postgres?sslmode=verify-full&sslrootcert=./global-bundle.pem
TEST_DATABASE_URL=postgresql+psycopg://project20:localdev123@localhost:5432/project20_test

# ------------------------------------------------------------
# AI API Keys (REQUIRED for full AI functionality)
# ------------------------------------------------------------

# Google AI Studio key — used for embedding via gemini-embedding-001 (768-dim vectors)
GEMINI_API_KEY=REMOVED_SECRET
# OpenRouter key — used for all chat/LLM completions via openrouter/free model
OPENROUTER_API_KEY=REMOVED_SECRET
# ------------------------------------------------------------
# Storage backend (local or s3)
# ------------------------------------------------------------
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
AWS_PROFILE_NAME=uoa-sso
S3_BUCKET_NAME=team8-project20-materials
# ------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=808017307980-sm46id212d0nuu7dtomb9hnsdkq3fp2v.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMOVED_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_STUDENT_DOMAINS=[aucklanduni.ac.nz]
GOOGLE_INSTRUCTOR_DOMAINS=[aucklanduni.ac.nz]
GOOGLE_INSTRUCTOR_ALLOWLIST=
GOOGLE_ALLOWED_LOGIN_DOMAINS=[aucklanduni.ac.nz,auckland.ac.nz]

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_SECRET_KEY=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# Rate limiting (requests per minute, per IP)
# ------------------------------------------------------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=5
RATE_LIMIT_DEFAULT=60

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
HOST=0.0.0.0
PORT=8000
DEBUG=true
