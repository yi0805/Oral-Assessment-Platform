DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

STORAGE_BACKEND=s3
S3_BUCKET_NAME=<s3-bucket-name>
AWS_REGION=ap-southeast-2

# EC2 production: leave AWS_PROFILE_NAME unset so boto3 uses the instance IAM
# role. Local development can set a named profile when needed.
# AWS_PROFILE_NAME=<local-aws-profile>

GEMINI_API_KEY=<gemini-api-key>
OPENROUTER_API_KEY=<openrouter-api-key>

# Leave AWS_BEARER_TOKEN_BEDROCK unset in current production. Setting it makes
# the AI gateway attempt Bedrock before OpenRouter.
# AWS_BEARER_TOKEN_BEDROCK=<bedrock-token-if-explicitly-enabled>

# Keep all Transcribe routes disabled unless the account, IAM permissions and
# production support have been explicitly validated.
TRANSCRIBE_ENABLED=false
STT_STREAMING_ENABLED=false
STT_STREAMING_MAX_SECONDS=300
TRANSCRIBE_POLL_INTERVAL_SECONDS=1

# A processing attempt older than this may be retried by its instructor.
MATERIAL_PROCESSING_STALE_SECONDS=1800

# A new user becomes an instructor if their email is explicitly allowlisted
# or their email domain is listed below.
GOOGLE_INSTRUCTOR_DOMAINS=example.edu
GOOGLE_INSTRUCTOR_ALLOWLIST=instructor1@example.edu,instructor2@example.edu

# Only users from these domains may sign in.
GOOGLE_ALLOWED_LOGIN_DOMAINS=example.edu

JWT_SECRET_KEY=<random-secret-string>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180

RATE_LIMIT_DEFAULT=300

# Safe deployment metadata for /version; never put infrastructure details here.
APP_VERSION=<deployment-version>
GIT_COMMIT=<deployment-git-commit>

# Local development:
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

# Production example:
# CORS_ORIGINS=["https://where-areyou.com"]
# COOKIE_SECURE=true
